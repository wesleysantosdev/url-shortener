DATABASE_URL=postgresql://admin:12345@localhost:3001/shortener_db
PORT=5000
CORS_ALLOWED_ORIGIN=http://localhost:5174
TRUST_PROXY_HOPS=0
RATE_LIMIT_IP_HASH_SECRET=replace-with-at-least-32-random-characters

REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=100
CACHE_ENABLED=true
REDIS_URL_CACHE_TTL_SECONDS=86400
REDIS_NEGATIVE_CACHE_TTL_SECONDS=60

CLICK_TRACKING_MODE=async
CLICK_BATCH_SIZE=500
CLICK_BATCH_INTERVAL_MS=5000
CLICK_QUEUE_MAX_LENGTH=1000000

CREATION_ATTEMPT_LIMIT=5
CREATION_ATTEMPT_WINDOW_SECONDS=60
CREATION_DAILY_LIMIT=20
CREATION_DAILY_WINDOW_SECONDS=86400
MAX_ACTIVE_URLS=100000

URL_RETENTION_DAYS=30
URL_DELETION_GRACE_HOURS=24
URL_CLEANUP_INTERVAL_HOURS=24
URL_CLEANUP_BATCH_SIZE=1000

# BENCHMARK_TARGET_URL=http://localhost:5000/replace-with-a-real-short-code
BENCHMARK_CONNECTIONS=50
BENCHMARK_DURATION_SECONDS=15

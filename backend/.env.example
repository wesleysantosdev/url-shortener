DATABASE_URL=postgresql://admin:12345@localhost:3001/shortener_db
PORT=5000

CORS_ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_SHORT_URL_BASE=http://localhost:5000
TRUST_PROXY_HOPS=0

RATE_LIMIT_IP_HASH_SECRET=replace-with-at-least-32-random-characters
SHORT_CODE_SECRET=replace-with-another-stable-32-character-secret
CREATION_ATTEMPT_LIMIT=5
CREATION_ATTEMPT_WINDOW_SECONDS=60
CREATION_DAILY_LIMIT=20
CREATION_DAILY_WINDOW_SECONDS=86400

REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_URL_CACHE_TTL_SECONDS=86400
